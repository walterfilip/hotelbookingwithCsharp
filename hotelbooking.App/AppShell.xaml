<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="hotelbooking.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:hotelbooking.App"
    Title="hotelbooking.App">

    <TabBar>
        <ShellContent Title="Rum"
                      ContentTemplate="{DataTemplate local:MainPage}"
                      Route="MainPage"/>
        <ShellContent Title="Bokningar"
                      ContentTemplate="{DataTemplate local:BookingPage}"
                      Route="BookingPage"/>
        <ShellContent Title="Ny bokning"
                      ContentTemplate="{DataTemplate local:CreateBookingPage}"
                      Route="CreateBookingPage"/>
    </TabBar>

</Shell>
